{
  "manifest_version": 3,
  "name": "InDigitual Hybrid Job Copilot",
  "version": "1.0.0",
  "description": "Match resumes locally, review autofill, tailor one approved section, and download a private DOCX copy.",
  "minimum_chrome_version": "139",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "action": {
    "default_title": "Open Hybrid Job Copilot"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://*.googleapis.com https://*.firebaseapp.com"
  }
}

